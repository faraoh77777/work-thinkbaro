# 서버 전용 환경변수입니다. 프런트 코드·브라우저로 전달되지 않습니다. 실제 값은 .env(커밋 금지)에 채우세요.
# 제공자: openai | anthropic  (anthropic은 글 작성만 지원, 음성 전사는 openai 필요)
AI_PROVIDER=
AI_API_KEY=
# 글 작성(제목·상세 작성)에 쓸 모델 이름 — 제공자 공식 문서에서 확인해 채웁니다.
AI_TEXT_MODEL=
# 음성 전사 모델 이름 (openai)
AI_TRANSCRIBE_MODEL=
# 선택: 서버 포트(기본 8787), 바인딩 주소(기본 127.0.0.1 — 공개 호스트에 그대로 여는 것은 권장하지 않음)
PORT=
HOST=

# 선택: 긴 글을 나누어 보낼 때 구간 하나의 크기(코드포인트, 기본 12000). 제품 글자 수 제한이 아니라 제공자 요청 한도에 맞추는 값입니다.
AI_CHUNK_CHARS=
# 선택: 전사 요청 1건의 오디오 최대 바이트(기본 25165824 = 24MB)
AI_MAX_AUDIO_BYTES=
